{
  "id": "meal-tracker",
  "name": "Registro de Refeições",
  "description": "Registre suas refeições com horário em tempo real e acompanhe seu histórico diário.",
  "version": "1.0.0",
  "manifestVersion": 1,
  "minSupVersion": "14.0.0",
  "author": "Antigravity",
  "permissions": [
    "showIndexHtmlAsView",
